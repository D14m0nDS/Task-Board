# --- Ports ---
POSTGRES_PORT=5432
BACKEND_PORT=8000

# --- Postgres ---
POSTGRES_USER=taskboard
POSTGRES_PASSWORD=taskboard
POSTGRES_DB=taskboard

# --- Backend ---
# Host is "localhost" for running uvicorn directly on your machine.
# docker-compose overrides the host to "db" for the containerised backend.
DATABASE_URL=postgresql+psycopg://taskboard:taskboard@localhost:5432/taskboard

# --- JWT ---
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5173
